rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to authenticated users on their own data
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;

      // Allow public read access to user profiles (for friends/leaderboards)
      allow read: if true;
    }

    // Match/Game history
    match /users/{uid}/matches/{matchId} {
      allow read, write: if request.auth.uid == uid;
      allow read: if true; // For leaderboards/stats
    }

    // Achievements
    match /users/{uid}/achievements/{achievementId} {
      allow read, write: if request.auth.uid == uid;
    }

    // Daily challenges
    match /daily_challenges/{challengeId} {
      allow read: if true;
      allow write: if false; // Only admin
    }

    // Leaderboards (read-only for clients)
    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if false; // Only admin/functions
    }

    // User search index
    match /user_index/{uid} {
      allow read: if true;
      allow write: if request.auth.uid == uid;
    }
  }
}
